# Database Configuration
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/roadmapdb
DATABASE_URL_TEST=postgresql://postgres:YOUR_PASSWORD@localhost:5432/roadmapdb_test

# JWT Configuration - Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=generate_your_own_secret_key_using_python_secrets_token_urlsafe_64
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Email Configuration (SendGrid) - Optional, not working so removed
# SENDGRID_API_KEY=your_sendgrid_api_key_here
# FROM_EMAIL=noreply@yourapp.com

# Environment
ENVIRONMENT=development

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000